  <!-- ===== Gramática ===== -->

  <rule id="CL_MAS_MEJOR" name="más mejor → mejor">
    <pattern>
      <marker><token regexp="yes" case_sensitive="no">más|mas</token><token regexp="yes" case_sensitive="no">mejor|mejores|peor|peores|mayor|mayores|menor|menores</token></marker>
    </pattern>
    <message>«Mejor», «peor», «mayor» y «menor» ya son comparativos: <suggestion>\2</suggestion>.</message>
    <example correction="mejor">es <marker>más mejor</marker></example>
  </rule>

  <rule id="CL_LE_LES" name="le dije a ellos → les">
    <pattern>
      <marker><token case_sensitive="no">le</token></marker>
      <token/>
      <token>a</token>
      <token regexp="yes">ellos|ellas|ustedes|todos|todas|ambos|ambas</token>
    </pattern>
    <message>Si se refiere a varias personas es plural: <suggestion><match no="1" case_conversion="preserve" regexp_match="(?i)^le$" regexp_replace="les"/></suggestion>.</message>
    <example correction="les"><marker>le</marker> dije a ellos</example>
  </rule>

  <rule id="CL_QUEISMO" name="me acuerdo que → me acuerdo de que">
    <pattern>
      <token regexp="yes">me|te|se|nos</token>
      <token regexp="yes" case_sensitive="no">acuerdo|acuerdas|acuerda|acordamos|acuerdan|acordé|acordaste|acordó|acordaron|olvidé|olvido|olvidaste|olvidó|olvidamos|alegro|alegra|alegramos|alegran|enteré|enteraste|enteró|enteramos|enteraron|arrepiento|arrepiente|percaté|percató</token>
      <marker><token>que</token></marker>
    </pattern>
    <message>Este verbo lleva «de»: <suggestion>de que</suggestion>.</message>
    <example correction="de que">me acuerdo <marker>que</marker> fui</example>
  </rule>

  <rule id="CL_QUEISMO_CUENTA" name="me di cuenta que → de que">
    <pattern>
      <token regexp="yes" case_sensitive="no">di|dio|diste|dimos|dieron|doy|das|da|damos|dan|dar|dando</token>
      <token>cuenta</token>
      <marker><token>que</token></marker>
    </pattern>
    <message>Se dice «darse cuenta <suggestion>de que</suggestion>».</message>
    <example correction="de que">me di cuenta <marker>que</marker> era tarde</example>
  </rule>

  <rule id="CL_QUEISMO_SEGURO" name="estoy seguro que → de que">
    <pattern>
      <token regexp="yes" case_sensitive="no">estoy|estás|estas|está|esta|estamos|están|estaba|estaban|estar|estuve|estoi</token>
      <token regexp="yes" case_sensitive="no">seguro|segura|seguros|seguras|convencido|convencida|convencidos|convencidas</token>
      <marker><token>que</token></marker>
    </pattern>
    <message>Se dice «estar seguro <suggestion>de que</suggestion>».</message>
    <example correction="de que">estoy seguro <marker>que</marker> vendrá</example>
  </rule>

  <!-- ===== Abreviaturas de chat ===== -->

  <rule id="CL_CHAT_PORQUE" name="xq / pq → porque">
    <pattern><token regexp="yes" case_sensitive="no">xq|pq|porq|xk|pk|xke|pke</token></pattern>
    <message>Abreviatura de chat. Escrito completo: <suggestion>porque</suggestion>, <suggestion>por qué</suggestion>.</message>
    <example correction="porque|por qué"><marker>xq</marker> no viniste</example>
  </rule>

  <rule id="CL_CHAT_TAMBIEN" name="tmb / tb → también">
    <pattern><token regexp="yes" case_sensitive="no">tmb|tb|tbn|tmbn|tambn</token></pattern>
    <message>Abreviatura de chat. Escrito completo: <suggestion>también</suggestion>.</message>
    <example correction="también"><marker>tmb</marker> voy</example>
  </rule>

  <rule id="CL_CHAT_QUE" name="k / q → que">
    <pattern><token regexp="yes" case_sensitive="yes">k|q|ke|qe</token></pattern>
    <message>Abreviatura de chat. Escrito completo: <suggestion>que</suggestion>, <suggestion>qué</suggestion>.</message>
    <example correction="que|qué">nada <marker>k</marker> ver</example>
  </rule>

