<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla del manifiesto MSIX. empaquetar.ps1 sustituye {{NOMBRE}}, {{EDITOR}} y {{VERSION}}.
     NOMBRE y EDITOR deben coincidir con los que asigna Partner Center al reservar el nombre de la app. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{NOMBRE}}" Publisher="{{EDITOR}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Corrector Local</DisplayName>
    <PublisherDisplayName>{{EDITOR_VISIBLE}}</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <Description>Corrector ortográfico y gramatical que funciona en tu PC. Se usa con la extensión Corrector Local para Microsoft Edge.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="CorrectorLocal" Executable="CorrectorLocal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Corrector Local"
        Description="Corrector ortográfico y gramatical local"
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Arranque con Windows (el usuario puede desactivarlo en Configuración → Aplicaciones → Inicio) -->
        <desktop:Extension Category="windows.startupTask" Executable="CorrectorLocal.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="CorrectorLocalServidor" Enabled="true" DisplayName="Corrector Local" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
